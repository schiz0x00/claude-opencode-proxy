{
  "name": "claude-opencode-proxy",
  "version": "0.1.0",
  "description": "Anthropic Messages API proxy that translates Claude Code traffic to OpenCode Zen/Go/Free wire formats",
  "type": "module",
  "license": "MIT",
  "author": "makan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schiz0x00/claude-opencode-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/schiz0x00/claude-opencode-proxy/issues"
  },
  "homepage": "https://github.com/schiz0x00/claude-opencode-proxy#readme",
  "keywords": [
    "claude-code",
    "anthropic",
    "opencode",
    "proxy",
    "llm-gateway"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "claude-opencode-proxy": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
